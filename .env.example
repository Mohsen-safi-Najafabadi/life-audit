# Copy this file to .env and fill in real values.
# .env is ignored by Git. Never commit real secrets.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me

# Optional. Defaults to a local SQLite file when not set.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/life_audit

# Production only.
# DJANGO_ALLOWED_HOSTS=your-domain.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com